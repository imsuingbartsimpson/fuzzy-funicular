--- ==========================================================
--- THREE-PAGE INSTANT NAVIGATION LOGIC
--- ==========================================================
local pageOrder = {"Farm", "Towers", "Credits"}
local currentIdx = 1

local function updatePage()
	local targetName = pageOrder[currentIdx]
	pageTitle.Text = targetName
	
	local offsetMultiplier = -(currentIdx - 1)
	pagesContainer.Position = UDim2.new(offsetMultiplier, 0, 0, 60)
end

leftArrow.MouseButton1Click:Connect(function()
	currentIdx = currentIdx - 1
	if currentIdx < 1 then currentIdx = #pageOrder end 
	updatePage()
end)

rightArrow.MouseButton1Click:Connect(function()
	currentIdx = currentIdx + 1
	if currentIdx > #pageOrder then currentIdx = 1 end 
	updatePage()
end)

